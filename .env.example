# Public site URL (used for sitemap, OG images, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://arranvanaerschot.dev

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random 32-byte hex string for JWT signing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Admin credentials (used by scripts/seed.ts)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Spotify currently playing integration
# See README for instructions on getting a refresh token
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
